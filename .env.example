# Пароль для входа в админ-панель (обязательно). Задаётся в Vercel: Settings → Environment Variables.
ADMIN_PASSWORD=""

# База данных Upstash Redis. При подключении через Vercel → Storage эти переменные добавляются сами
# (KV_REST_API_URL / KV_REST_API_TOKEN или UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN).
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Уведомления о новых записях в Telegram (необязательно).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
