# Пароль для входа в админ-панель (обязательно). Задаётся в Vercel: Settings → Environment Variables.
ADMIN_PASSWORD=""

# База данных Upstash Redis. При подключении через Vercel → Storage эти переменные добавляются сами
# (KV_REST_API_URL / KV_REST_API_TOKEN или UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN).
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Уведомления о новых записях в Telegram (необязательно).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ИИ-помощник в WhatsApp (необязательно; без этих переменных бот выключен).
# Meta: developers.facebook.com → приложение → WhatsApp → API Setup / Configuration.
WHATSAPP_TOKEN=""            # постоянный токен System user
WHATSAPP_PHONE_NUMBER_ID=""  # Phone number ID номера бота
WHATSAPP_APP_SECRET=""       # App secret приложения (Settings → Basic) — проверка подписи запросов Meta
WHATSAPP_VERIFY_TOKEN=""     # любая придуманная строка, та же в настройке Webhook
# Claude: console.anthropic.com → API keys.
ANTHROPIC_API_KEY=""
# WHATSAPP_BOT_MODEL="claude-opus-5-5"   # по желанию: другая модель Claude
# WHATSAPP_API_VERSION="v23.0"           # по желанию: версия Graph API
